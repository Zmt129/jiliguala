<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志存储路径 -->
    <property name="LOG_PATH" value="logs"/>
    <!-- 日志格式 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- INFO 级别日志文件 -->
    <appender name="FILE_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/buding-info.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 日志文件名格式 -->
            <fileNamePattern>${LOG_PATH}/buding-info.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 最大日志文件大小 -->
<!--            <maxFileSize>10MB</maxFileSize>-->
            <!-- 最多保留30天的日志文件 -->
            <maxHistory>30</maxHistory>
            <!-- 存储空间限制 -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <!-- 只记录INFO及以上级别的日志 -->
            <level>INFO</level>
            <!-- ACCEPT 表示匹配的日志级别 -->
            <onMatch>ACCEPT</onMatch>
            <!-- DENY 表示不匹配的日志级别 -->
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- ERROR 级别日志文件 -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/buding-error.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/buding-error.%d{yyyy-MM-dd}.log</fileNamePattern>
<!--            <maxFileSize>10MB</maxFileSize>-->
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 开发环境配置 -->
    <springProfile name="dev">
        <root level="INFO">
            <!-- 输出到控制台 -->
            <appender-ref ref="CONSOLE"/>
            <!-- 输出到文件 -->
            <appender-ref ref="FILE_INFO"/>
            <!-- 输出到文件 -->
            <appender-ref ref="FILE_ERROR"/>
        </root>
        <logger name="com.example.auth" level="DEBUG" additivity="false">
            <!-- 输出到控制台 -->
            <appender-ref ref="CONSOLE"/>
            <!-- 输出到文件 -->
            <appender-ref ref="FILE_INFO"/>
            <!-- 输出到文件 -->
            <appender-ref ref="FILE_ERROR"/>
        </logger>
    </springProfile>

    <!-- 生产环境配置 -->
    <springProfile name="prod">
        <root level="INFO">
            <!-- 输出到文件 -->
            <appender-ref ref="FILE_INFO"/>
            <!-- 输出到文件 -->
            <appender-ref ref="FILE_ERROR"/>
        </root>
        <logger name="com.example.auth" level="INFO" additivity="false">
            <!-- 输出到文件 -->
            <appender-ref ref="FILE_INFO"/>
            <!-- 输出到文件 -->
            <appender-ref ref="FILE_ERROR"/>
        </logger>
    </springProfile>

    <!-- 默认配置（无环境指定时） -->
    <root level="INFO">
        <!-- 输出到控制台 -->
        <appender-ref ref="CONSOLE"/>
        <!-- 输出到文件 -->
        <appender-ref ref="FILE_INFO"/>
        <!-- 输出到文件 -->
        <appender-ref ref="FILE_ERROR"/>
    </root>
    <logger name="com.example.auth" level="DEBUG" additivity="false">
        <!-- 输出到控制台 -->
        <appender-ref ref="CONSOLE"/>
        <!-- 输出到文件 -->
        <appender-ref ref="FILE_INFO"/>
        <!-- 输出到文件 -->
        <appender-ref ref="FILE_ERROR"/>
    </logger>

    <!-- 第三方框架日志级别控制 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="io.jsonwebtoken" level="WARN"/>
</configuration>
